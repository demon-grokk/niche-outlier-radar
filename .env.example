# ==============================================================================
# Niche Outlier Radar - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# NOTE: All settings have sensible defaults. The core platform (RSS ingestion,
# channel catalog, median calculation, and dashboard) functions without any API key.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq API Configuration (Optional)
# ------------------------------------------------------------------------------
# Used for generating AI Creator Cards (takeaways, tools, viral angles)
# and Whisper audio fallback when YouTube captions are disabled.
# Free API key available at: https://console.groq.com/keys
GROQ_API_KEY=

# LLM Models for Outlier Analysis
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3
WHISPER_AUDIO_DURATION_SECONDS=120

# ------------------------------------------------------------------------------
# 2. Feed & Outlier Scoring Defaults
# ------------------------------------------------------------------------------
# Minimum view-to-median ratio to flag as an outlier
OUTLIER_MULTIPLIER=1.8

# Strict freshness window (in days) for recent feed inclusion
RECENCY_DAYS=15

# Maximum items returned in main feed view
FEED_LIMIT=50

# Rolling video count used to compute channel median baseline
MEDIAN_BASELINE_COUNT=50

# Absolute view floor for micro-creator outlier eligibility
MIN_VIDEO_VIEWS_FLOOR=1000

# ------------------------------------------------------------------------------
# 3. Background Sync & Networking
# ------------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=6
DEFAULT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36
